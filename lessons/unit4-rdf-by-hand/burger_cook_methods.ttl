# Burger ontology add-on: cook methods as an ENUMERATION (Day 38) and a class that is also
# its own SHACL shape (Day 39). It extends burger.ttl, so it uses the same burger: namespace.
#
# Pattern 1, enumerations as named things. A cook method could be the text "fried". Instead,
# each allowed value is a named thing (an individual) with its own IRI:
#   - text can be misspelled ("fryed") or mean two things ("fried" in oil? in a pan?);
#     an IRI is either one of the list or it isn't;
#   - a named thing can carry facts: a clean name, a number code, a definition, the
#     equipment it needs.
# The name ("fried") and the code (0) are kept in separate properties. Never pack them into
# one string like "0-fried": the label stays clean and each part can be queried.
#
# Real-world example of the same pattern: the BACnet ontology generated by csml2rdf,
# https://github.com/JoelBender/csml2rdf/blob/main/bacnet.ttl
# (e.g. bacnet:AbortReason.other a bacnet:AbortReasonEnumerationValue ; bacnet:name "other" ;
#  bacnet:value "0"^^xsd:nonNegativeInteger).
@prefix burger: <https://example.org/burger#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# ---- the enumeration: one class for the list, one named thing per allowed value
burger:EnumerationValue a owl:Class ;
    rdfs:label "Enumeration value" ;
    skos:definition "One allowed value from a fixed list, as a named thing instead of text." .

burger:CookMethodEnumerationValue a owl:Class ;
    rdfs:subClassOf burger:EnumerationValue ;
    rdfs:label "Cook method" ;
    skos:definition "How a menu item is cooked. Only the named values below are allowed." .

burger:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    skos:definition "The short, clean name of an enumeration value." ;
    rdfs:range xsd:string .

burger:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    skos:definition "The number code of an enumeration value, e.g. for a point-of-sale system." ;
    rdfs:range xsd:nonNegativeInteger .

burger:needsEquipmentClass a owl:ObjectProperty ;
    rdfs:label "needs equipment class" ;
    skos:definition "The kind of equipment a cook method needs." .

# The values. The dot in "CookMethod.fried" is just part of the name, like BACnet's.
burger:CookMethod.fried a burger:CookMethodEnumerationValue ;
    rdfs:label "fried" ;
    burger:name "fried" ;
    burger:value "0"^^xsd:nonNegativeInteger ;
    skos:definition "Cooked in hot oil." ;
    burger:needsEquipmentClass burger:Fryer .

burger:CookMethod.grilled a burger:CookMethodEnumerationValue ;
    rdfs:label "grilled" ;
    burger:name "grilled" ;
    burger:value "1"^^xsd:nonNegativeInteger ;
    skos:definition "Cooked on a hot flat grill." ;
    burger:needsEquipmentClass burger:Grill .

burger:CookMethod.none a burger:CookMethodEnumerationValue ;
    rdfs:label "not cooked" ;
    burger:name "none" ;
    burger:value "2"^^xsd:nonNegativeInteger ;
    skos:definition "Served as it is, e.g. a drink." .

# The property that points at a value. Its range is the enumeration class, not xsd:string.
burger:cookMethod a owl:ObjectProperty ;
    rdfs:label "cook method" ;
    skos:definition "How a menu item is cooked: one of the CookMethod values." ;
    rdfs:domain burger:MenuItem ;
    rdfs:range burger:CookMethodEnumerationValue .

# ---- Pattern 2, a class that is ALSO a SHACL shape (Day 39).
# Because burger:FriedMenuItem is both a class and an sh:NodeShape, SHACL checks every
# instance of the class (an "implicit class target": no sh:targetClass needed).
# The rule travels with the class: whoever loads the ontology gets it.
# The SHACL spec asks for rdfs:Class + sh:NodeShape; owl:Class keeps it an OWL class too.
burger:FriedMenuItem a owl:Class, rdfs:Class, sh:NodeShape ;
    rdfs:subClassOf burger:MenuItem ;
    rdfs:label "Fried menu item" ;
    skos:definition "A menu item cooked in a fryer." ;
    sh:property [
        sh:path burger:cookMethod ;
        sh:hasValue burger:CookMethod.fried ;   # the value must be exactly this named thing
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A fried menu item has exactly one cook method: CookMethod.fried." ;
    ] .
