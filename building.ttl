    brick:hasPoint <https://example.org/openfdd/BUILDING_50#AHU_1_SF_Alarm>,
        <https://example.org/openfdd/BUILDING_50#AHU_1_SF_Cmd>,
        <https://example.org/openfdd/BUILDING_50#AHU_1_SF_OnOff_Status>,
        <https://example.org/openfdd/BUILDING_50#AHU_1_SF_Run_Status>,
