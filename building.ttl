<https://example.org/openfdd/BUILDING_50#timeseries_db> a brick:Database,
        ns1:Database ;
    rdfs:label "SQLite timeseries store (tutorial stand-in for a TSDB)" ;
    ns2:backend "sqlite" ;
    ns2:connectionEnv "BLDGTS_DB_PATH" ;
    ns2:schemaDescription "samples(timeseries_id TEXT, ts INTEGER epoch-s UTC, value REAL)" .

