@prefix bldg: <https://example.org/openfdd/BUILDING_50#> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ref: <https://brickschema.org/schema/Brick/ref#> .
@prefix bts: <https://example.org/openfdd/brickts#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .

unit:DEG_F a qudt:Unit .
unit:IN_H2O a qudt:Unit .
unit:PERCENT a qudt:Unit .

bldg:Site a brick:Site ;
  rdfs:label "BUILDING_50 tutorial site" ;
  brick:hasPart bldg:Building_50 .

bldg:Building_50 a brick:Building ;
  rdfs:label "BUILDING_50" ;
  brick:isPartOf bldg:Site ;
  brick:hasPart bldg:Floor_1, bldg:Floor_2, bldg:Floor_3 .

bldg:Floor_1 a brick:Floor ;
  rdfs:label "First Floor" ;
  brick:isPartOf bldg:Building_50 .

bldg:Floor_2 a brick:Floor ;
  rdfs:label "Second Floor" ;
  brick:isPartOf bldg:Building_50 .

bldg:Floor_3 a brick:Floor ;
  rdfs:label "Third Floor" ;
  brick:isPartOf bldg:Building_50 .

bldg:AHU_1 a brick:Air_Handler_Unit ;
  rdfs:label "AHU_1" ;
  brick:isLocatedIn bldg:Building_50 ;
  brick:hasPart bldg:AHU_1_Supply_Fan, bldg:AHU_1_Return_Fan, bldg:AHU_1_OA_Damper,
    bldg:AHU_1_EA_Damper, bldg:AHU_1_CHW_Valve .

bldg:AHU_1_Supply_Fan a brick:Supply_Fan ;
  rdfs:label "Supply Fan" ;
  brick:isPartOf bldg:AHU_1 .

bldg:AHU_1_Return_Fan a brick:Return_Fan ;
  rdfs:label "Return Fan" ;
  brick:isPartOf bldg:AHU_1 .

bldg:AHU_1_OA_Damper a brick:Outside_Damper ;
  rdfs:label "Outside Air Damper" ;
  brick:isPartOf bldg:AHU_1 .

bldg:AHU_1_EA_Damper a brick:Exhaust_Damper ;
  rdfs:label "Exhaust Air Damper" ;
  brick:isPartOf bldg:AHU_1 .

bldg:AHU_1_CHW_Valve a brick:Chilled_Water_Valve ;
  rdfs:label "CHW Valve" ;
  brick:isPartOf bldg:AHU_1 .

bldg:timeseries_db a ref:Database, brick:Database ;
  rdfs:label "SQLite timeseries store (tutorial stand-in for a TSDB)" ;
  bts:backend "sqlite" ;
  bts:connectionEnv "BRICKTS_DB_PATH" ;
  bts:schemaDescription "samples(timeseries_id TEXT, ts INTEGER epoch-s UTC, value REAL)" .

bldg:Zone_AHU_1 a brick:HVAC_Zone ;
  rdfs:label "Zone AHU 1" ;
  brick:isPartOf bldg:Floor_1 ;
  brick:isFedBy bldg:AHU_1 .
bldg:AHU_1 brick:feeds bldg:Zone_AHU_1 .

