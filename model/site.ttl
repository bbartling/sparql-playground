@prefix bldg: <https://example.org/openfdd/BUILDING_50#> .
@prefix bts: <https://example.org/openfdd/bldgts#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ref: <https://brickschema.org/schema/Brick/ref#> .

bldg:AHU_1 a bts:Entity ;
    rdfs:label "AHU_1" ;
    bts:hasHaystackMarker "ahu",
        "equip" ;
    bts:hasHaystackTag [ bts:tagKind "Ref" ;
            bts:tagName "siteRef" ;
            bts:tagValue bldg:Building_50 ] .

bldg:AHU_2 a bts:Entity ;
    rdfs:label "AHU_2" ;
    bts:hasHaystackMarker "ahu",
        "equip" ;
    bts:hasHaystackTag [ bts:tagKind "Ref" ;
            bts:tagName "siteRef" ;
            bts:tagValue bldg:Building_50 ] .

bldg:timeseries_db a ref:Database ;
    rdfs:label "SQLite timeseries store (tutorial stand-in for a TSDB)" ;
    bts:backend "sqlite" ;
    bts:connectionEnv "BLDGTS_DB_PATH" ;
    bts:schemaDescription "samples(timeseries_id TEXT, ts INTEGER epoch-s UTC, value REAL)" .

bldg:Building_50 a bts:Entity ;
    rdfs:label "BUILDING_50" ;
    bts:hasHaystackMarker "site" ;
    bts:hasHaystackTag [ bts:tagKind "Str" ;
            bts:tagName "tz" ;
            bts:tagValue "America/Chicago" ] .

