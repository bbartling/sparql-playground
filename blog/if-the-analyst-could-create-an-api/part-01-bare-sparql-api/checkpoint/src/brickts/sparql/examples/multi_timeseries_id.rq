PREFIX brick: <https://brickschema.org/schema/Brick#>
PREFIX bldg: <https://example.org/openfdd/BUILDING_50#>
PREFIX ref: <https://brickschema.org/schema/Brick/ref#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

SELECT ?point (COUNT(?ts) AS ?n) WHERE {
  ?point a ?cls .
  ?cls (rdfs:subClassOf|owl:equivalentClass)* brick:Point .
  FILTER(STRSTARTS(STR(?point), STR(bldg:)))
  ?point ref:hasExternalReference ?ref .
  ?ref ref:hasTimeseriesId ?ts .
}
GROUP BY ?point
HAVING (COUNT(?ts) != 1)
